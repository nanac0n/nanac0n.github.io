---
import Base from '../layouts/Base.astro';
import { SITE_TITLE, SITE_DESCRIPTION, GITHUB_URL } from '../consts';
---

<Base title="About" description={`About ${SITE_TITLE}.`}>
  <h1>about</h1>
  <div class="prose">
    <p>{SITE_DESCRIPTION}</p>
    <p>Code and lab material live on <a href={GITHUB_URL}>GitHub</a>.</p>
  </div>
</Base>
